      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "A quel prix sont les roses?",
      "translated": "Која е цената на розите?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Je désire un bouquet de tulipes",
      "translated": "Би сакал/а букет лалиња.",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Vous êtes un nouveau marchand de fleurs",
