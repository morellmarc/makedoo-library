    {
      "original": "A la boucherie",
      "translated": "Во месарницата",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Avez-vous de la viande de porc?",
      "translated": "Дали имате свинско месо?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Je voudrais un kilo",
      "translated": "Би сакал/а еден килограм",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Je désire un kilo de bœuf et une livre de veau",
      "translated": "Би сакал/а еден килограм говедско месо и една фунта телешко месо.",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Donnez-moi un morceau de deux kilos de porc",
      "translated": "Дај ми парче свинско месо од два килограми",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Une livre de pâté",
      "translated": "Една фунта паштета",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Du pâté de porc ou du pâté de foie?",
      "translated": "Паштета од свинско месо или паштета од црн дроб?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Donnez-moi un kilo de jambon!",
