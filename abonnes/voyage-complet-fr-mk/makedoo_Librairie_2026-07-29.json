    {
      "original": "Avez-vous de papier à lettres?",
      "translated": "Дали имате некаков лист за пишување?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Donnez-moi du papier à lettres et une enveloppe, s'il vous plaît!",
      "translated": "Дајте ми хартија за пишување и плико, ве молам!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Pouvez-vous me remplir le stylo?",
      "translated": "Можеш ли да ми го наполниш пенкалото?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Combien coûte cette machine à écrire?",
      "translated": "Колку чини оваа машина за пишување?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Je voudrais cinq stylos à bille",
