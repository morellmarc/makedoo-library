      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Voici vos ordonnances",
      "translated": "Еве ги вашите рецепти",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Merci beaucoup, docteur",
