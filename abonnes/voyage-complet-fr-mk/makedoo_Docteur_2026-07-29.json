  "exchanges": [
    {
      "original": "La santé — Chez le docteur",
      "translated": "Здравје — Кај лекар",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Où est l'hôpital, s'il vous plaît!",
      "translated": "Каде е болницата, ве молам?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Appelez le médecin, s'il vous plaît!",
      "translated": "Ве молам јавете се на доктор!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "L'adresse d'un bon médecin?",
      "translated": "Адресата на добар доктор?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Je voudrais consulter un spécialiste",
      "translated": "Би сакал/а да се консултирам со специјалист",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Quelles sont les heures de consultation?",
      "translated": "Кои се часовите за консултации?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Bonjour, docteur!",
      "translated": "Bonjour, docteur!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Qu'avez-vous?",
      "translated": "Што не е во ред?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Qu'est-ce que vous fait mal?",
      "translated": "Што те боли?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Depuis quand êtes-vous malade?",
      "translated": "Колку долго си болен/а?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Depuis trois jours",
      "translated": "За три дена",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "J'ai mal ici",
      "translated": "Имам болки тука",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Je suis tombé",
      "translated": "Паднав",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Je suis enrhumé",
      "translated": "Имам настинка.",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "J'ai de la fièvre",
      "translated": "Имам треска",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "J'ai mal à la gorge",
      "translated": "Ме боли грлото.",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "J'ai mal à la tête",
      "translated": "имам главоболка",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Ma température est normale",
      "translated": "Мојата температура е нормална",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Bien",
      "translated": "ДОБРО",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Déshabillez-vous!",
      "translated": "Соблечи се! Соблечи се!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Couchez-vous sur ce divan!",
      "translated": "Легнете на оваа кауч!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Respirez!",
      "translated": "Диши!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Toussez!",
      "translated": "Кашлица!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Ouvrez la bouche!",
      "translated": "Отвори ја устата!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Tirez la langue!",
      "translated": "Исплази го јазикот! (Испразни го јазикот!)",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Est-ce que je peux me lever?",
      "translated": "Може ли да станам?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Oui",
      "translated": "Да",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Habillez-vous, s'il vous plaît!",
      "translated": "Ве молам облечете се!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Je vais vous faire une ordonnance",
      "translated": "Ќе ти напишам рецепт",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Vous devez garder le lit quelques jours",
      "translated": "Треба да останете во кревет неколку дена.",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Est-ce que je dois revenir?",
      "translated": "Дали треба да се вратам?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Combien je vous dois?",
