    {
      "original": "La chambre et le service",
      "translated": "Собата и услугата",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Appelez la femme de chambre!",
      "translated": "Јави се на собарката!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Veuillez nettoyer la chambre et la salle de bains!",
      "translated": "Ве молам исчистете ја спалната соба и бањата!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Voulez-vous me donner une nouvelle serviette de toilette?",
      "translated": "Дали би сакале да ми дадете нова крпа за бањање?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Apportez-moi deux draps, un oreiller et une couverture!",
      "translated": "Донесете ми два чаршафи, перница и ќебе!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Réveillez-moi à cinq heures!",
      "translated": "Разбуди ме во пет часот!",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Il fait trop chaud (froid) dans la chambre",
      "translated": "Премногу е топло (ладно) во собата",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Le radiateur ne chauffe pas",
      "translated": "Радијаторот не се загрева",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Où est le bouton d'appel?",
