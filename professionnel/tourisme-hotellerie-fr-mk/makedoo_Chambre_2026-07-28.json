      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Est-ce que j'ai du courrier?",
      "translated": "Дали имам некаква пошта?",
      "langFrom": "fr",
      "langTo": "mk"
    },
    {
      "original": "Où est-ce que je peux faire (nettoyer) laver quelque chose?",
